# Build artifacts and local state never belong in the image.
target/
.git/
.scratch/

# Host-side runtime data: the database lives on a bind mount, never in the
# image. Keeping it out of the context avoids accidentally baking personal
# hand data into a layer.
data/
hands/
*.sqlite
*.sqlite-shm
*.sqlite-wal

# Scratch and editor noise.
*.log
.env
.DS_Store

# Anything that could carry local secrets or machine-specific noise. The
# Dockerfile runs `COPY . .`, so this list is also a privacy boundary.
.env.*
!.env.example
*.db
*.db-*
*.sqlite3
*.sqlite3-*
*.pem
*.key
*.log
coverage/
*.profraw
.idea/
.vscode/
*.iml
*.swp
*.swo
*~
*.tmp
*.bak
.DS_Store
compose.override.yaml
compose.override.yml
docker-compose.override.yaml
docker-compose.override.yml
